# 사이트 공개 URL (sitemap, OG 이미지 절대경로에 사용) — 빌드 시점에 반영됩니다
NEXT_PUBLIC_SITE_URL=https://www.withthelake.com

# Google Analytics 4 측정 ID — 설정하면 자동으로 로드됩니다
NEXT_PUBLIC_GA_ID=

# CONTACT US 접수 메일 — Cloudflare Pages Function(functions/api/contact.ts) + Resend
# 정적 빌드에는 필요하지 않습니다. 배포 환경은 Cloudflare Pages → Settings → Variables and Secrets 에,
# 로컬(npm start)은 프로젝트 루트의 .dev.vars 파일에 넣습니다. RESEND_API_KEY 는 Secret 으로 등록하세요.
# RESEND_API_KEY 또는 CONTACT_TO_EMAIL 이 없으면 문의 API 가 503 안내를 반환합니다.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=WITH THE LAKE <noreply@withthelake.com>

# 관리자 (로컬 전용) — npm run admin 으로 실행하고 http://localhost:8788/admin 에서 사용합니다.
# 아래 값은 프로젝트 루트의 .dev.vars 파일(git 제외)에 넣습니다. 운영 환경에는 등록하지 않습니다.
# ADMIN_ENABLED=true
# GITHUB_TOKEN=          # Fine-grained token: 이 저장소만, Contents 읽기·쓰기 + Commit statuses 읽기
# GITHUB_REPO=WithTheLake-test/withthelake.com
# GITHUB_BRANCH=         # 관리자 저장이 커밋될 브랜치 (테스트 중에는 main 이 아닌 테스트 브랜치)
